{
  "$schema": "https://tr.designtokens.org/format/",
  "color": {
    "background": {
      "black":  { "$value": "#000000", "$type": "color" },
      "white":  { "$value": "#FAFAFA", "$type": "color" }
    },
    "violet": {
      "wash":    { "$value": "#EDE9FE", "$type": "color", "$description": "Callouts, tinted backgrounds (use sparingly)" },
      "light":   { "$value": "#C4B5FD", "$type": "color", "$description": "Text on dark backgrounds" },
      "hover":   { "$value": "#7C3AED", "$type": "color", "$description": "Hover state of primary CTA" },
      "base":    { "$value": "#6D28D9", "$type": "color", "$description": "RESERVED — single primary action per surface + brand mark only" },
      "pressed": { "$value": "#5B21B6", "$type": "color", "$description": "Active / pressed state of primary CTA" }
    },
    "midnight": {
      "base":     { "$value": "#0F172A", "$type": "color", "$description": "Dominant accent — default for everything that isn't the one primary action" },
      "light":    { "$value": "#1E293B", "$type": "color", "$description": "Cards and surfaces on dark" },
      "muted":    { "$value": "#334155", "$type": "color", "$description": "Body text on light, borders on dark" },
      "subtext":  { "$value": "#94A3B8", "$type": "color", "$description": "Secondary text on dark backgrounds" },
      "on-dark":  { "$value": "#F8FAFC", "$type": "color", "$description": "Primary text on dark backgrounds" }
    },
    "gray": {
      "base":  { "$value": "#6B7280", "$type": "color", "$description": "Helper text, captions" },
      "light": { "$value": "#9CA3AF", "$type": "color", "$description": "Input placeholders" }
    },
    "surface": { "$value": "#F1F5F9", "$type": "color" },
    "border":  { "$value": "#E2E8F0", "$type": "color" },
    "status": {
      "success": { "$value": "#10B981", "$type": "color" },
      "warning": { "$value": "#F59E0B", "$type": "color" },
      "danger":  { "$value": "#DC2626", "$type": "color" },
      "info":    { "$value": "#6D28D9", "$type": "color" }
    }
  },

  "font": {
    "family": {
      "display": { "$value": "Montserrat, \"Helvetica Neue\", system-ui, -apple-system, sans-serif", "$type": "fontFamily" },
      "body":    { "$value": "Inter, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif", "$type": "fontFamily" },
      "mono":    { "$value": "\"JetBrains Mono\", ui-monospace, \"SF Mono\", Menlo, Consolas, monospace", "$type": "fontFamily" }
    },
    "weight": {
      "regular":   { "$value": 400, "$type": "fontWeight" },
      "medium":    { "$value": 500, "$type": "fontWeight" },
      "semibold":  { "$value": 600, "$type": "fontWeight" },
      "bold":      { "$value": 700, "$type": "fontWeight" },
      "extrabold": { "$value": 800, "$type": "fontWeight" }
    },
    "size": {
      "display":  { "$value": "72px", "$type": "dimension" },
      "h1":       { "$value": "56px", "$type": "dimension" },
      "h2":       { "$value": "40px", "$type": "dimension" },
      "h3":       { "$value": "28px", "$type": "dimension" },
      "h4":       { "$value": "22px", "$type": "dimension" },
      "lead":     { "$value": "20px", "$type": "dimension" },
      "body":     { "$value": "16px", "$type": "dimension" },
      "small":    { "$value": "14px", "$type": "dimension" },
      "caption":  { "$value": "12px", "$type": "dimension" },
      "eyebrow":  { "$value": "11px", "$type": "dimension" }
    },
    "lineHeight": {
      "tight":   { "$value": 1.05 },
      "snug":    { "$value": 1.2 },
      "normal":  { "$value": 1.45 },
      "relaxed": { "$value": 1.6 }
    },
    "tracking": {
      "tight":   { "$value": "-0.02em" },
      "normal":  { "$value": "0" },
      "wide":    { "$value": "0.04em" },
      "eyebrow": { "$value": "0.14em" }
    }
  },

  "spacing": {
    "0":  { "$value": "0",     "$type": "dimension" },
    "1":  { "$value": "4px",   "$type": "dimension" },
    "2":  { "$value": "8px",   "$type": "dimension" },
    "3":  { "$value": "12px",  "$type": "dimension" },
    "4":  { "$value": "16px",  "$type": "dimension" },
    "5":  { "$value": "20px",  "$type": "dimension" },
    "6":  { "$value": "24px",  "$type": "dimension" },
    "8":  { "$value": "32px",  "$type": "dimension" },
    "10": { "$value": "40px",  "$type": "dimension" },
    "12": { "$value": "48px",  "$type": "dimension" },
    "16": { "$value": "64px",  "$type": "dimension" },
    "20": { "$value": "80px",  "$type": "dimension" },
    "24": { "$value": "96px",  "$type": "dimension" },
    "32": { "$value": "128px", "$type": "dimension" }
  },

  "radius": {
    "xs":   { "$value": "4px",   "$type": "dimension" },
    "sm":   { "$value": "8px",   "$type": "dimension" },
    "md":   { "$value": "12px",  "$type": "dimension" },
    "lg":   { "$value": "16px",  "$type": "dimension" },
    "xl":   { "$value": "24px",  "$type": "dimension" },
    "2xl":  { "$value": "32px",  "$type": "dimension" },
    "pill": { "$value": "999px", "$type": "dimension", "$description": "Chips and primary CTAs (marketing)" }
  },

  "shadow": {
    "xs":     { "$value": "0 1px 2px rgba(15, 23, 42, 0.04)", "$type": "shadow" },
    "sm":     { "$value": "0 1px 3px rgba(15, 23, 42, 0.06), 0 1px 2px rgba(15, 23, 42, 0.04)", "$type": "shadow" },
    "md":     { "$value": "0 4px 12px rgba(15, 23, 42, 0.08), 0 2px 4px rgba(15, 23, 42, 0.04)", "$type": "shadow" },
    "lg":     { "$value": "0 12px 32px rgba(15, 23, 42, 0.10), 0 4px 8px rgba(15, 23, 42, 0.04)", "$type": "shadow" },
    "xl":     { "$value": "0 24px 64px rgba(15, 23, 42, 0.14), 0 8px 16px rgba(15, 23, 42, 0.06)", "$type": "shadow" },
    "accent": { "$value": "0 12px 32px rgba(109, 40, 217, 0.28)", "$type": "shadow", "$description": "Brand-accent shadow — use only under hero CTAs" }
  },

  "motion": {
    "ease": {
      "out":       { "$value": "cubic-bezier(0.16, 1, 0.3, 1)" },
      "inOut":     { "$value": "cubic-bezier(0.65, 0, 0.35, 1)" },
      "standard":  { "$value": "cubic-bezier(0.4, 0, 0.2, 1)" }
    },
    "duration": {
      "fast": { "$value": "120ms" },
      "base": { "$value": "200ms" },
      "slow": { "$value": "320ms" },
      "page": { "$value": "480ms" }
    }
  }
}
