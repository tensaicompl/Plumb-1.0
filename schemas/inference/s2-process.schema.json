{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "S2 process analysis output",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "processes"],
  "properties": {
    "version": { "const": 1 },
    "processes": {
      "type": "array",
      "items": { "$ref": "#/$defs/process" }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "node_key": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_ref", "start", "end"],
      "properties": {
        "requirement_ref": { "$ref": "#/$defs/id" },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 1 }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/range" }
    },
    "grounded_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_ref", "evidence"],
      "properties": {
        "target_ref": { "$ref": "#/$defs/id" },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "optional_grounded_ref": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/grounded_ref" }]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_key",
        "node_kind",
        "operation",
        "performers",
        "produces",
        "message_ref",
        "timer_expr",
        "evidence"
      ],
      "properties": {
        "node_key": { "$ref": "#/$defs/node_key" },
        "node_kind": {
          "enum": [
            "start",
            "end",
            "human_task",
            "service_task",
            "exclusive_gateway",
            "parallel_split",
            "parallel_join",
            "message_event",
            "timer_event",
            "error_event",
            "subprocess"
          ]
        },
        "operation": { "$ref": "#/$defs/optional_grounded_ref" },
        "performers": { "type": "array", "items": { "$ref": "#/$defs/grounded_ref" } },
        "produces": { "type": "array", "items": { "$ref": "#/$defs/grounded_ref" } },
        "message_ref": { "$ref": "#/$defs/optional_grounded_ref" },
        "timer_expr": { "oneOf": [{ "type": "null" }, { "type": "string" }] },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "next": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_key", "to_key", "evidence"],
      "properties": {
        "from_key": { "$ref": "#/$defs/node_key" },
        "to_key": { "$ref": "#/$defs/node_key" },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "evidence", "nodes", "next"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/evidence" },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
        "next": { "type": "array", "items": { "$ref": "#/$defs/next" } }
      }
    }
  }
}
