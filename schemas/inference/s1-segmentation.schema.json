{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "segments"],
  "properties": {
    "version": {
      "const": 1
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fragment_ref",
          "start",
          "end",
          "classification"
        ],
        "properties": {
          "fragment_ref": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9._-]+(?::[A-Za-z0-9._-]+)*$"
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 1
          },
          "classification": {
            "type": "string",
            "enum": [
              "requirement_candidate",
              "non_requirement"
            ]
          }
        }
      }
    }
  }
}
