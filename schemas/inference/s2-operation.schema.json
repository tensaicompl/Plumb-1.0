{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "S2 operation analysis output",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "operations"],
  "properties": {
    "version": { "const": 1 },
    "operations": {
      "type": "array",
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_ref", "start", "end"],
      "properties": {
        "requirement_ref": { "$ref": "#/$defs/id" },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 1 }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/range" }
    },
    "grounded_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_ref", "evidence"],
      "properties": {
        "target_ref": { "$ref": "#/$defs/id" },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "grounded_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/grounded_ref" }
    },
    "optional_grounded_ref": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/grounded_ref" }]
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "outcome_kind", "evidence"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "outcome_kind": {
          "enum": ["success", "business_failure", "technical_failure", "partial"]
        },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "new_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "payload_schema_ref", "evidence"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "payload_schema_ref": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }]
        },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "operation_kind",
        "evidence",
        "performers",
        "reads",
        "writes",
        "governed_by",
        "uses_calculation",
        "input_schema",
        "output_schema",
        "outcomes",
        "new_produced_events",
        "produced_event_refs",
        "consumed_event_refs"
      ],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "operation_kind": { "enum": ["command", "query"] },
        "evidence": { "$ref": "#/$defs/evidence" },
        "performers": { "$ref": "#/$defs/grounded_refs" },
        "reads": { "$ref": "#/$defs/grounded_refs" },
        "writes": { "$ref": "#/$defs/grounded_refs" },
        "governed_by": { "$ref": "#/$defs/grounded_refs" },
        "uses_calculation": { "$ref": "#/$defs/grounded_refs" },
        "input_schema": { "$ref": "#/$defs/optional_grounded_ref" },
        "output_schema": { "$ref": "#/$defs/optional_grounded_ref" },
        "outcomes": {
          "type": "array",
          "items": { "$ref": "#/$defs/outcome" }
        },
        "new_produced_events": {
          "type": "array",
          "items": { "$ref": "#/$defs/new_event" }
        },
        "produced_event_refs": { "$ref": "#/$defs/grounded_refs" },
        "consumed_event_refs": { "$ref": "#/$defs/grounded_refs" }
      }
    }
  }
}
