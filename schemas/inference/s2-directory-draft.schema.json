{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "actors",
    "business_roles",
    "rules",
    "decision_tables"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "actor_kind",
          "grounding_refs"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "actor_kind": {
            "enum": [
              "human",
              "system",
              "external_system",
              "organization"
            ]
          },
          "grounding_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9._-]+(?::[A-Za-z0-9._-]+)*$"
            }
          }
        }
      }
    },
    "business_roles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "grounding_refs"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "grounding_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9._-]+(?::[A-Za-z0-9._-]+)*$"
            }
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "rule_kind",
          "grounding_refs"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "rule_kind": {
            "enum": [
              "constraint",
              "derivation",
              "permission",
              "validation",
              "business"
            ]
          },
          "grounding_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9._-]+(?::[A-Za-z0-9._-]+)*$"
            }
          }
        }
      }
    },
    "decision_tables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "grounding_refs",
          "hit_policy",
          "inputs",
          "outputs",
          "rows"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "grounding_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9._-]+(?::[A-Za-z0-9._-]+)*$"
            }
          },
          "hit_policy": {
            "enum": [
              "UNIQUE",
              "FIRST"
            ]
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "type",
                "members",
                "scale"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "bool",
                    "enum",
                    "int",
                    "decimal"
                  ]
                },
                "members": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "scale": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              }
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "type",
                "members",
                "scale"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "bool",
                    "enum",
                    "int",
                    "decimal"
                  ]
                },
                "members": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "scale": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              }
            }
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "inputs",
                "outputs"
              ],
              "properties": {
                "inputs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "cell",
                      "value",
                      "members"
                    ],
                    "properties": {
                      "cell": {
                        "enum": [
                          "any",
                          "bool",
                          "enum_set"
                        ]
                      },
                      "value": {
                        "type": [
                          "boolean",
                          "null"
                        ]
                      },
                      "members": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "outputs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "cell",
                      "value"
                    ],
                    "properties": {
                      "cell": {
                        "enum": [
                          "bool",
                          "enum",
                          "int",
                          "decimal"
                        ]
                      },
                      "value": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
