{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "actors",
    "business_roles",
    "rules",
    "decision_tables"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "actor_kind",
          "grounding_refs"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "actor_kind": {
            "enum": [
              "human",
              "system",
              "external_system",
              "organization"
            ]
          },
          "grounding_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9._-]+(?::[A-Za-z0-9._-]+)*$"
            }
          }
        }
      }
    },
    "business_roles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "grounding_refs"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "grounding_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9._-]+(?::[A-Za-z0-9._-]+)*$"
            }
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "rule_kind",
          "grounding_refs"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "rule_kind": {
            "enum": [
              "constraint",
              "derivation",
              "permission",
              "validation",
              "business"
            ]
          },
          "grounding_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9._-]+(?::[A-Za-z0-9._-]+)*$"
            }
          }
        }
      }
    },
    "decision_tables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "grounding_refs",
          "hit_policy",
          "inputs",
          "outputs",
          "rows"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "grounding_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9._-]+(?::[A-Za-z0-9._-]+)*$"
            }
          },
          "hit_policy": {
            "enum": [
              "UNIQUE",
              "FIRST"
            ]
          },
          "inputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "ty"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                },
                "ty": {
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "type"
                      ],
                      "properties": {
                        "type": {
                          "const": "bool"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "type",
                        "members"
                      ],
                      "properties": {
                        "type": {
                          "const": "enum"
                        },
                        "members": {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "string",
                            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "outputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "ty"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                },
                "ty": {
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "type"
                      ],
                      "properties": {
                        "type": {
                          "const": "bool"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "type",
                        "members"
                      ],
                      "properties": {
                        "type": {
                          "const": "enum"
                        },
                        "members": {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "string",
                            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                          }
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "type"
                      ],
                      "properties": {
                        "type": {
                          "const": "int"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "type",
                        "scale"
                      ],
                      "properties": {
                        "type": {
                          "const": "decimal"
                        },
                        "scale": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 28
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "rows": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "inputs",
                "outputs"
              ],
              "properties": {
                "inputs": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "cell"
                        ],
                        "properties": {
                          "cell": {
                            "const": "any"
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "cell",
                          "value"
                        ],
                        "properties": {
                          "cell": {
                            "const": "bool"
                          },
                          "value": {
                            "type": "boolean"
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "cell",
                          "members"
                        ],
                        "properties": {
                          "cell": {
                            "const": "enum_set"
                          },
                          "members": {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                              "type": "string",
                              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                            }
                          }
                        }
                      }
                    ]
                  }
                },
                "outputs": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "cell",
                          "value"
                        ],
                        "properties": {
                          "cell": {
                            "const": "bool"
                          },
                          "value": {
                            "type": "boolean"
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "cell",
                          "member"
                        ],
                        "properties": {
                          "cell": {
                            "const": "enum"
                          },
                          "member": {
                            "type": "string",
                            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "cell",
                          "value"
                        ],
                        "properties": {
                          "cell": {
                            "const": "int"
                          },
                          "value": {
                            "type": "integer"
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "cell",
                          "value"
                        ],
                        "properties": {
                          "cell": {
                            "const": "decimal"
                          },
                          "value": {
                            "type": "string",
                            "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
