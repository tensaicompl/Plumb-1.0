{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "calculations"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "calculations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name_range",
          "expression",
          "expression_evidence",
          "result_type",
          "unit",
          "rounding",
          "calendar_ref"
        ],
        "properties": {
          "name_range": {
            "$ref": "#/$defs/grounding"
          },
          "expression": {
            "type": "string",
            "minLength": 1
          },
          "expression_evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/grounding"
            }
          },
          "result_type": {
            "type": "string",
            "pattern": "^(String|Int|Bool|Date|DateTime|Decimal\\((0|[1-9]|1[0-9]|2[0-8])\\))$"
          },
          "unit": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          },
          "rounding": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          },
          "calendar_ref": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/id"
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9._-]+(?::[A-Za-z0-9._-]+)*$"
    },
    "grounding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_ref",
        "start",
        "end"
      ],
      "properties": {
        "requirement_ref": {
          "$ref": "#/$defs/id"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
